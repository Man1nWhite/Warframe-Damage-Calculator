{
  "meta": {
    "title": "Condition Overload (GunCO) multiplicative stacking tables",
    "wiki_url": "https://wiki.warframe.com/w/Condition_Overload_(Mechanic)",
    "wiki_page_status": "community/unofficial page, banner: actively being worked on",
    "wiki_page_last_edited": "2026-10-05",
    "data_retrieved": "2026-10-27",
    "cross_reference": "dmerced05/verbose-spork-wf-calc src/calc/conditionOverload.ts - wiki pull Oct 2026 plus rainy's GunCO sheet 38.0.12 (Feb 2025); vendored at source/conditionOverload.ts",
    "catalog_scope": "The wiki lists only discrepant attacks. Any attack not listed behaves as intended: additive +100% of the CO-type bonus.",
    "default_resolution": {
      "unlisted_hitscan_aoe": "add, scale 1.0, direct-hit target only",
      "unlisted_projectile_aoe_radius": "none - projectile explosion radii never receive CO",
      "unlisted_regular_attack": "add, scale 1.0"
    }
  },
  "stacking_modes": {
    "multiply": {
      "label": "Multiplying (wiki behavior #1, not intended; mostly projectiles)",
      "formula": "Base x MostDamageBonuses x (1 + CO_bonus) x OtherMultipliers",
      "description": "The CO-type bonus stacks additively with other CO-type bonuses only, then multiplies against ordinary +% damage bonuses (Serration, Hornet Strike, Vex Armor, Arcane Fury, Pressure Point, ...)."
    },
    "add": {
      "label": "Adding (wiki behaviors #2-#4, intended; most hitscan weapons)",
      "formula": "Base x (MostDamageBonuses x OtherMultipliers + CO_bonus x scale)",
      "description": "The CO-type bonus is added to the ordinary +% damage pool. 'scale' is the wiki's CO-bonus-relative-to-base column for attacks whose CO only counts part of the base (charged bows, child projectiles, AoE on the directly hit target). Final multipliers are ignored."
    },
    "none": {
      "label": "Does not apply (wiki behavior #5; AoE radii and known bugs)",
      "formula": "CO_bonus contribution = 0",
      "description": "Explosion/radius damage of projectile weapons, plus a handful of documented bugged attacks (Azima turret, Balefire Charger, Glory, Sonicor, Stug, ...)."
    }
  },
